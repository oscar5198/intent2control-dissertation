{
  "schema_version": "phase6c_baseline_models_v2",
  "protocol_version": "phase6c_baseline_prediction_v1",
  "output_version": "phase6c_heldout_baseline_v1",
  "prediction_quantity": "posterior_expected_mean_rating",
  "credible_interval_level": 0.95,
  "convergence_thresholds": {
    "fit_ok_max_rhat": 1.01,
    "fit_ok_min_bulk_ess": 100,
    "fit_ok_min_tail_ess": 100,
    "fit_ok_max_divergences": 0,
    "warning_max_rhat": 1.05,
    "warning_min_bulk_ess": 50,
    "warning_min_tail_ess": 50
  },
  "winner_derivation": {
    "primary_quantity": "posterior_mean_expected_rating",
    "exact_tie_rule": "mark_tied_no_ground_truth_tiebreak"
  },
  "draw_level_winner_tie_rule": "split_probability_equally_across_draw_tied_maxima",
  "inference_modes": {
    "production": {
      "label": "production",
      "analytical": true,
      "description": "Frozen final Phase 3 Bayesian configuration for real held-out baseline prediction.",
      "draws": 1000,
      "tune": 1000,
      "chains": 4,
      "cores": 1,
      "target_accept": 0.95,
      "inference_method": "nutpie"
    },
    "smoke_test": {
      "label": "smoke_test",
      "analytical": false,
      "description": "Non-analytical lightweight synthetic execution check only; never use for final real-data predictions.",
      "draws": 5,
      "tune": 5,
      "chains": 1,
      "cores": 1,
      "target_accept": 0.95,
      "inference_method": "default"
    }
  },
  "models": [
    {
      "model_id": "categorical_design",
      "role": "primary",
      "formula": "rating ~ episode + group + (1 | participant_id) + (1 | stimulus_id)",
      "required_predictors": [
        "episode",
        "group",
        "participant_id",
        "stimulus_id"
      ],
      "random_seed": 42
    },
    {
      "model_id": "primary_acoustic",
      "role": "primary",
      "formula": "rating ~ episode + group + z_RMS + z_CF + z_SW + (1 | participant_id) + (1 | stimulus_id)",
      "required_predictors": [
        "episode",
        "group",
        "z_RMS",
        "z_CF",
        "z_SW",
        "participant_id",
        "stimulus_id"
      ],
      "random_seed": 44
    },
    {
      "model_id": "si_sensitivity",
      "role": "sensitivity",
      "formula": "rating ~ episode + group + z_RMS + z_CF + z_SW + z_SI + (1 | participant_id) + (1 | stimulus_id)",
      "required_predictors": [
        "episode",
        "group",
        "z_RMS",
        "z_CF",
        "z_SW",
        "z_SI",
        "participant_id",
        "stimulus_id"
      ],
      "random_seed": 44
    }
  ]
}
