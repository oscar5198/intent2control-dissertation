# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtual environments and local configuration
.venv/
venv/
env/
.env

# Conda environments
.conda/
conda-meta/
envs/

# Jupyter
.ipynb_checkpoints/
.jupyter/

# Data and generated artefacts
data/raw/*
data/processed/*
results/*
experiments/*
outputs/*
bibliography/papers/*

# Keep placeholder files for empty tracked directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
!experiments/.gitkeep
!outputs/.gitkeep
!bibliography/papers/.gitkeep

# Audio assets and corpora should be stored outside git unless explicitly curated
*.wav
*.mp3
*.flac
*.aiff
*.aif

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
