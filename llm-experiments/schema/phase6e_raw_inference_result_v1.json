{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase6e_raw_inference_result_v1",
  "title": "Phase 6E.1 Canonical Raw Inference Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inference_interface_version",
    "inference_request_id",
    "rendered_prompt_id",
    "prediction_example_id",
    "condition",
    "model_key",
    "backend_key",
    "backend_type",
    "prompt_package_version",
    "response_schema_version",
    "attempt_type",
    "attempt_number",
    "request_status",
    "raw_response_text",
    "provider_response_metadata",
    "usage",
    "latency",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "phase6e_raw_inference_result_v1"},
    "inference_interface_version": {"const": "phase6e_inference_interface_v1"},
    "inference_request_id": {"type": "string"},
    "rendered_prompt_id": {"type": "string"},
    "prediction_example_id": {"type": "string"},
    "condition": {"enum": ["non_history", "personalised_history"]},
    "model_key": {"type": "string"},
    "backend_key": {"type": "string"},
    "backend_type": {"type": "string"},
    "prompt_package_version": {"const": "phase6d_prompt_package_v1"},
    "response_schema_version": {"const": "preference_prediction_response_v1"},
    "attempt_type": {"enum": ["primary", "format_repair"]},
    "attempt_number": {"type": "integer", "minimum": 1},
    "request_status": {"enum": ["completed", "timeout", "error", "backend_unavailable"]},
    "raw_response_text": {"type": ["string", "null"]},
    "provider_response_metadata": {"type": ["object", "null"]},
    "usage": {"type": ["object", "null"]},
    "latency": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]}
  }
}
