{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase6e_attempt_log_v1",
  "title": "Phase 6E.3 Inference Attempt Log Record",
  "type": "object",
  "required": [
    "schema_version",
    "prediction_logging_version",
    "run_id",
    "inference_request_id",
    "prediction_record_id",
    "prediction_example_id",
    "rendered_prompt_id",
    "condition",
    "model_key",
    "backend_key",
    "prompt_package_version",
    "response_schema_version",
    "inference_config_version",
    "attempt_type",
    "attempt_number",
    "request_status",
    "response_validation_status",
    "raw_response_text",
    "prompt_payload_sha256",
    "inference_config_sha256"
  ],
  "properties": {
    "schema_version": {"const": "phase6e_attempt_log_v1"},
    "prediction_logging_version": {"const": "phase6e_prediction_logging_v1"},
    "failure_handling_version": {"type": ["string", "null"]},
    "attempt_type": {"enum": ["primary", "format_repair"]},
    "attempt_number": {"type": "integer", "minimum": 1},
    "request_status": {"enum": ["completed", "timeout", "error", "backend_unavailable"]},
    "response_validation_status": {"enum": ["valid", "invalid_json", "schema_invalid", "missing_response"]},
    "attempt_status": {
      "enum": [
        "request_not_started",
        "request_completed",
        "timeout",
        "connection_error",
        "http_client_error",
        "http_server_error",
        "backend_unavailable",
        "rate_limited",
        "bad_credentials",
        "unsupported_model",
        "empty_response",
        "invalid_json",
        "schema_invalid",
        "valid"
      ]
    },
    "failure_code": {"type": ["string", "null"]},
    "failure_category": {"type": ["string", "null"]},
    "transport_attempt_number": {"type": "integer", "minimum": 1},
    "parent_inference_request_id": {"type": "string"},
    "scientific_generation_id": {"type": "string"},
    "raw_response_text": {"type": ["string", "null"]},
    "token_usage": {"type": "object"},
    "cost_metadata": {"type": "object"},
    "latency_seconds": {"type": ["number", "null"]}
  }
}
